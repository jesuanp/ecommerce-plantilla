# Stripe test keys — get them at https://dashboard.stripe.com/test/apikeys
# Leave empty to use the built-in demo (simulated) checkout flow.
STRIPE_SECRET_KEY=
PORT=4242

# Base URL of the backend API used by the frontend (vite client).
# Defaults to http://localhost:4242/api if unset.
VITE_API_BASE_URL=/api

# Bank transfer (transferencia bancaria) — datos que verá el cliente en checkout
VITE_BANK_NAME=Banco: 0102
VITE_BANK_ACCOUNT=C.I: 30123456
VITE_BANK_PHONE=Tel: 04121234567
