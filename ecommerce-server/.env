# Database
DB_NAME=raybert_db
DB_USER=postgres
DB_PASS=password
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET=lumen-dev-secret-2024-change-in-production
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server
PORT=4242
CROSS_SITE_COOKIES=true
CORS_ORIGINS=https://raybertshop.netlify.app
NODE_ENV=production

# Uploads (product images, payment proofs)
# In production this MUST be an absolute path OUTSIDE the git repo, so a
# `git pull` / redeploy never touches uploaded files. Example: /var/www/raybert-uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
